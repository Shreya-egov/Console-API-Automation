# Base URL for API
BASE_URL=https://your-api-url.com

# Tenant Configuration
TENANTID=your-tenant-id
LOCALE=en_IN

# Authentication Credentials
USERNAME=your-username
PASSWORD=your-password
USERTYPE=EMPLOYEE
CLIENT_AUTH_HEADER=Basic your-oauth-token

# Search Configuration
SEARCH_LIMIT=10
SEARCH_OFFSET=0

# Boundary Configuration
HIERARCHYTYPE=ADMIN
BOUNDARY_CODE=your-boundary-code
BOUNDARY_TYPE=your-boundary-type

# Service Endpoints
SERVICE_PROJECT=/project/v1
SERVICE_PROJECT_FACILITY=/project/facility/v1
SERVICE_PROJECT_STAFF=/project/staff/v1
SERVICE_PROJECT_FACTORY=/project-factory/v1/project-type
SERVICE_EXCEL_INGESTION=/excel-ingestion/v1/data
SERVICE_FILESTORE=/filestore/v1/files
